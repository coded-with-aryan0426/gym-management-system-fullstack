{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"console.log('\\n🚀 Starting AthlonX Dev Server...\\n'); const {execSync} = require('child_process'); const os = require('os'); const nets = os.networkInterfaces(); let localIP = 'localhost'; for (const name of Object.keys(nets)) { for (const net of nets[name]) { if (net.family === 'IPv4' && !net.internal) { localIP = net.address; break; } } if (localIP !== 'localhost') break; } console.log('\\n📡 Sharable URLs (all 5 portals):\\n'); console.log('   Portal 1: http://' + localIP + ':5173'); console.log('   Portal 2: http://' + localIP + ':5174'); console.log('   Portal 3: http://' + localIP + ':5175'); console.log('   Portal 4: http://' + localIP + ':5176'); console.log('   Portal 5: http://' + localIP + ':5177\\n'); execSync('vite --host', {stdio: 'inherit'});\"",
    "dev:portal1": "vite --port 5173 --host",
    "dev:portal2": "vite --port 5174 --host",
    "dev:portal3": "vite --port 5175 --host",
    "dev:portal4": "vite --port 5176 --host",
    "dev:portal5": "vite --port 5177 --host",
    "dev:all": "concurrently -n P1,P2,P3,P4,P5 -c blue,green,yellow,magenta,cyan \"npm run dev:portal1\" \"npm run dev:portal2\" \"npm run dev:portal3\" \"npm run dev:portal4\" \"npm run dev:portal5\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify-json/game-icons": "^1.2.3",
    "@iconify/react": "^6.0.2",
    "@lottiefiles/dotlottie-react": "^0.18.10",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@react-oauth/google": "^0.13.4",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/lodash": "^4.17.24",
    "@types/react-grid-layout": "^2.1.0",
    "@types/sockjs-client": "^1.5.4",
    "animejs": "^4.3.6",
    "axios": "^1.14.0",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lodash": "^4.18.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.7.0",
    "net": "^1.0.2",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.3",
